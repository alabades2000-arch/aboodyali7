{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Open Android Studio",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/cap",
      "args": ["open", "android"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Sync & Open Android",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/cap",
      "args": ["sync", "android"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "preLaunchTask": "build-vite"
    },
    {
      "name": "Run on Device",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/.bin/cap",
      "args": ["run", "android"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
